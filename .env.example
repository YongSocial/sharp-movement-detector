# mainnet | devnet
NETWORK=devnet

# Path to a local Solana keypair JSON (array of 64 bytes), used to sign the
# free-tier subscription tx and the activation message.
WALLET_KEYPAIR_PATH=./wallet-keypair.json

# Free tier service level: 1 = 60s delay (works on mainnet+devnet), 12 = mainnet real-time
SERVICE_LEVEL_ID=1

# --- Detector tuning ---
# Minimum absolute odds swing (decimal odds delta) to flag as "sharp"
MOVE_THRESHOLD=0.5
# Minimum % swing relative to previous price to flag as "sharp"
MOVE_THRESHOLD_PCT=0.15
# Rolling window (ms) used to compare current price against baseline
LOOKBACK_MS=3600000

PORT=4000
